/* =========================
   موبائل
========================= */

@media (max-width: 700px) {

    .hero {

        padding:
            60px 18px 75px;
    }


    .intro {

        padding:
            28px 22px;
    }


    .services {

        grid-template-columns: 1fr;
    }


    .shop-info {

        grid-template-columns: 1fr;
    }


    .section {

        padding: 50px 0;
    }


    .order-box {

        padding:
            30px 20px;
    }

}

</style>


<!DOCTYPE html>
<html lang="ur" dir="rtl">

<head>

<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0">

<title>نوری باباجان ٹائرز — پشاور</title>

<meta name="description"
      content="نوری باباجان ٹائرز، امان بزنس سنٹر، نزد ہزار خوانی چوک، رنگ روڈ پشاور۔ ٹائرز، رم اور کمپیوٹرائزڈ بیلنسنگ کی سہولت۔">

<style>

/* =========================
   بنیادی انداز
========================= */

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {

    margin: 0;

    background: #f4f0e7;

    color: #263238;

    font-family:
        "Noto Nastaliq Urdu",
        "Jameel Noori Nastaleeq",
        serif;

    line-height: 2;

    text-align: right;
}


/* =========================
   مرکزی چوڑائی
========================= */

.container {

    width: min(100% - 36px, 1000px);

    margin-inline: auto;
}


/* =========================
   HERO
========================= */

.hero {

    position: relative;

    overflow: hidden;

    background:
        radial-gradient(
            circle at top,
            #1b6b50 0%,
            #06291e 65%
        );

    color: white;

    padding: 75px 20px 95px;

    text-align: center;
}


/* ہلکا سا آرائشی دائرہ */

.hero::after {

    content: "";

    position: absolute;

    width: 300px;
    height: 300px;

    border: 1px solid
        rgba(244,215,123,.22);

    border-radius: 50%;

    top: -150px;
    left: -100px;
}


.hero-content {

    position: relative;

    z-index: 2;

    max-width: 850px;

    margin: auto;
}


.hero h1 {

    margin: 0;

    color: white;

    font-size:
        clamp(2.8rem, 8vw, 5rem);

    line-height: 1.5;

    font-weight: 800;
}


.hero-subtitle {

    margin-top: 8px;

    color: #f4d77b;

    font-size:
        clamp(1.1rem, 3vw, 1.5rem);
}


.gold-line {

    width: 120px;

    height: 4px;

    margin: 25px auto;

    background: #f4d77b;

    border-radius: 20px;
}


.hero-tagline {

    margin: 0;

    font-size:
        clamp(1.6rem, 4vw, 2.6rem);

    font-weight: 700;
}


.hero-small {

    margin-top: 8px;

    color: #f4d77b;

    font-size: 1.15rem;
}


/* =========================
   تعارف
========================= */

.intro {

    position: relative;

    margin-top: -45px;

    background: #fffdf8;

    padding: 40px;

    border-radius: 22px;

    box-shadow:
        0 15px 45px rgba(0,0,0,.10);

    z-index: 5;
}


.intro h2 {

    margin: 0 0 15px;

    color: #0d5139;

    font-size: 2rem;
}


.intro p {

    margin: 0;

    font-size: 1.15rem;
}


.highlight {

    margin-top: 22px;

    padding: 16px 20px;

    background: #f8f0d4;

    border-right: 5px solid #c79d32;

    border-radius: 12px;

    color: #0d5139;

    font-weight: 700;
}


/* =========================
   عمومی سیکشن
========================= */

.section {

    padding: 65px 0;
}


.section-title {

    margin-bottom: 30px;

    color: #0d5139;

    font-size:
        clamp(1.8rem, 4vw, 2.5rem);
}


.section-title span {

    display: block;

    color: #c79d32;

    font-size: 1rem;
}


/* =========================
   خدمات
========================= */

.services {

    display: grid;

    grid-template-columns:
        repeat(2, 1fr);

    gap: 22px;
}


.service-card {

    background: #fffdf8;

    padding: 30px;

    border-radius: 20px;

    border-top: 4px solid #f4d77b;

    box-shadow:
        0 8px 28px rgba(0,0,0,.07);

    transition: .2s;
}


.service-card:hover {

    transform:
        translateY(-5px);

    box-shadow:
        0 15px 35px rgba(0,0,0,.12);
}


.service-icon {

    font-size: 2.3rem;

    margin-bottom: 8px;
}


.service-card h3 {

    margin: 0 0 8px;

    color: #0d5139;

    font-size: 1.4rem;
}


.service-card p {

    margin: 0;

    font-size: 1rem;
}


/* =========================
   دکان کی معلومات
========================= */

.shop-section {

    background:
        linear-gradient(
            135deg,
            #06291e,
            #0d5139
        );

    color: white;

    padding: 70px 0;
}


.shop-section .section-title {

    color: white;
}


.shop-info {

    display: grid;

    grid-template-columns:
        repeat(2, 1fr);

    gap: 20px;
}


.info-card {

    padding: 25px;

    background:
        rgba(255,255,255,.08);

    border: 1px solid
        rgba(244,215,123,.30);

    border-radius: 18px;
}


.info-card strong {

    display: block;

    color: #f4d77b;

    font-size: 1.15rem;

    margin-bottom: 5px;
}


.info-card p {

    margin: 0;

    font-size: 1rem;
}


/* =========================
   رابطہ
========================= */

.contact {

    text-align: center;

    padding: 65px 20px;
}


.contact h2 {

    margin: 0;

    color: #0d5139;

    font-size: 2.2rem;
}


.phone {

    display: inline-block;

    margin-top: 20px;

    padding: 14px 30px;

    background: #0d5139;

    color: white;

    text-decoration: none;

    border-radius: 12px;

    font-size: 1.2rem;

    direction: ltr;
}


.whatsapp {

    display: inline-block;

    margin-top: 15px;

    padding: 12px 25px;

    background: #1f8f55;

    color: white;

    text-decoration: none;

    border-radius: 12px;

    font-size: 1.05rem;
}


/* =========================
   آن لائن آرڈر
========================= */

.order-section {

    background: #eee4cb;

    padding: 70px 20px;

    text-align: center;
}


.order-box {

    max-width: 750px;

    margin: auto;

    background: #fffdf8;

    padding: 40px 30px;

    border-radius: 22px;

    box-shadow:
        0 10px 35px rgba(0,0,0,.08);
}


.order-box h2 {

    margin: 0 0 10px;

    color: #0d5139;

    font-size: 2.2rem;
}


.order-box p {

    margin: 0;
}


.order-button {

    display: inline-block;

    margin-top: 25px;

    padding: 14px 35px;

    background: #c79d32;

    color: white;

    text-decoration: none;

    border-radius: 12px;

    font-size: 1.1rem;

    font-weight: bold;
}


/* =========================
   FOOTER
========================= */

footer {

    background: #06291e;

    color: white;

    text-align: center;

    padding: 35px 20px;
}


.footer-brand {

    color: #f4d77b;

    font-size: 1.25rem;

    font-weight: bold;
}


footer p {

    margin: 5px 0;

    font-size: .95rem;
